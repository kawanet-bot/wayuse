{
  "name": "wayuse-workspace",
  "description": "Workspace for wayuse-builder, wayuse-server and wayuse-client.",
  "author": "Kawanet",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "rollup": "^4.68.2",
    "ts-refine": "^0.6.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/wayuse.git"
  },
  "scripts": {
    "build": "make -C builder",
    "fixpack": "fixpack && fixpack packages/wayuse-builder/package.json && fixpack packages/wayuse-server/package.json && fixpack packages/wayuse-client/package.json",
    "test": "make -C builder test",
    "ts-refine": "./node_modules/.bin/ts-refine format && ./node_modules/.bin/ts-refine imports"
  },
  "type": "module",
  "workspaces": [
    "packages/wayuse-builder",
    "packages/wayuse-server",
    "packages/wayuse-client"
  ]
}
