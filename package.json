{
  "name": "wayuse-workspace",
  "description": "Workspace for @wayuse/build, @wayuse/server and wayuse.",
  "version": "0.1.0",
  "author": "Kawanet",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@types/node": "^24.19.2",
    "@types/novnc__novnc": "^1.6.0",
    "@types/ws": "^8.18.2",
    "html-slim": "^0.5.0",
    "rollup": "^4.68.2",
    "ts-refine": "^0.6.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/wayuse.git"
  },
  "scripts": {
    "build": "make -C builder",
    "fixpack": "fixpack && fixpack packages/build/package.json && fixpack packages/server/package.json && fixpack packages/wayuse/package.json",
    "get-version": "npm pkg get version --workspaces --include-workspace-root",
    "prepare": "make -C builder is-not-buildable 2> /dev/null || make -C builder clean all test",
    "set-version": "npm version --workspaces --include-workspace-root --no-git-tag-version",
    "test": "make -C builder test",
    "ts-refine": "./node_modules/.bin/ts-refine format && ./node_modules/.bin/ts-refine imports"
  },
  "type": "module",
  "workspaces": [
    "packages/build",
    "packages/server",
    "packages/wayuse"
  ]
}
